APP_NAME=Infbyte
APP_ENV=local
APP_DEBUG=true

CACHE_STORE=local
CACHE_PREFIX=infbyte:

AUTH_STORAGE=memory
AUTH_CACHE=array
AUTH_PASSWORDS=native
AUTH_TOKENS=simple
AUTH_MFA=simple
AUTH_NOTIFICATIONS=collect
AUTH_PASSKEY=disabled
AUTH_TOKEN_SECRET=foundation-dev-secret
AUTH_CACHE_STORE=local
AUTH_DB_CONNECTION=sqlite

NOTIFICATIONS_AUTH_FAIL_SILENTLY=false
NOTIFICATIONS_AUTH_FROM=
NOTIFICATIONS_AUTH_TRANSPORT=null

DB_CONNECTION=sqlite
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Infbyte
WEBAUTHN_ORIGIN=
WEBAUTHN_USER_VERIFICATION=preferred
WEBAUTHN_RESIDENT_KEY=preferred
