{
    "name": "infocyph/infbyte",
    "description": "A secure PHP framework powered by Infocyph Foundation.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "infocyph/foundation": "^0.1.01"
    },
    "require-dev": {
        "infocyph/phpforge": "dev-main@dev"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "app:ready": "@php infbyte app:ready",
        "auth:schema:install": "@php infbyte auth:schema:install",
        "auth:schema:status": "@php infbyte auth:schema:status",
        "config:cache": "@php infbyte config:cache",
        "config:clear": "@php infbyte config:clear",
        "route:cache": "@php infbyte route:cache",
        "route:clear": "@php infbyte route:clear"
    }
}
