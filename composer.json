{
    "name": "infocyph/infbyte",
    "description": "A secure PHP framework powered by Infocyph Foundation.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "infocyph/foundation": "dev-main",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
