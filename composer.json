{
    "name": "infocyph/infbyte",
    "description": "The minimal application skeleton for Infocyph Foundation.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "infocyph/foundation": "^1.3"
    },
    "require-dev": {
        "infocyph/phpforge": "dev-main@dev"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-create-project-cmd": "@php infbyte app:install"
    }
}
