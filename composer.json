{
    "name": "infocyph/infbyte",
    "description": "A secure PHP framework powered by Infocyph Foundation.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "infocyph/foundation": "dev-main"
    },
    "require-dev": {
        "infocyph/phpforge": "dev-main@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../Foundation",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "route:cache": "@php infbyte route:cache",
        "route:clear": "@php infbyte route:clear"
    }
}
